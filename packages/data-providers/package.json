{
  "name": "@stock-assistant/data-providers",
  "version": "1.0.0",
  "description": "Provider-neutral interfaces for market and financial data ingestion",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
