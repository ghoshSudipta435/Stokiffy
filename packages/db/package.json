{
  "name": "@stock-assistant/db",
  "version": "1.0.0",
  "description": "PostgreSQL database layer with Prisma ORM and repository pattern",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "files": [
    "dist",
    "src",
    "prisma"
  ],
  "scripts": {
    "build": "tsc",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "prisma:generate": "prisma generate",
    "prisma:validate": "prisma validate",
    "db:seed": "vite-node prisma/seeds/seed.ts"
  },
  "dependencies": {
    "@prisma/client": "^5.10.0",
    "@stock-assistant/contracts": "workspace:*"
  },
  "devDependencies": {
    "@types/node": "^22.0.0",
    "prisma": "^5.10.0",
    "typescript": "^5.6.0",
    "vitest": "^2.0.0"
  },
  "publishConfig": {
    "access": "private"
  }
}
