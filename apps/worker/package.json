{
  "name": "@stokiffy/worker",
  "version": "1.0.0",
  "private": true,
  "description": "Background worker and job queue daemon for Stokiffy financial ingestion and scheduled alerts",
  "main": "dist/index.js",
  "type": "module",
  "scripts": {
    "build": "tsc -b",
    "dev": "tsx watch src/index.ts",
    "start": "node dist/index.js",
    "test": "vitest run",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit",
    "clean": "rm -rf dist tsconfig.tsbuildinfo"
  },
  "dependencies": {
    "@stock-assistant/contracts": "workspace:*",
    "@stock-assistant/core": "workspace:*",
    "@stock-assistant/data-providers": "workspace:*",
    "@stock-assistant/db": "workspace:*",
    "dotenv": "^16.4.5",
    "pg": "^8.12.0",
    "pg-boss": "^10.1.3",
    "zod": "^3.23.8"
  },
  "devDependencies": {
    "@types/node": "^20.17.0",
    "@types/pg": "^8.11.6",
    "typescript": "^5.6.3",
    "vitest": "^2.1.4"
  }
}
