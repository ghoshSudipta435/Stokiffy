# ==============================================================================
# Stokiffy - Local Development & Production Environment Configuration
# ==============================================================================

# Node Environment ('development' | 'test' | 'production')
NODE_ENV=development

# Database Connection (Neon PostgreSQL with SSL and connection timeout)
# Local: postgresql://stokiffy:stokiffy_dev@localhost:5432/stokiffy_dev?schema=public
# Neon: postgresql://<user>:<password>@<endpoint>.aws.neon.tech/<dbname>?sslmode=require&connect_timeout=30
DATABASE_URL="postgresql://stokiffy:stokiffy_dev@localhost:5432/stokiffy_dev?schema=public"

# Web Application & NextAuth
NEXTAUTH_URL="http://localhost:3000"
NEXTAUTH_SECRET="generate-a-strong-32-byte-secret-via-openssl-rand-hex-32"
API_V1_PREFIX="/api/v1"

# Production Personal Authentication (NextAuth Credentials Provider)
ADMIN_EMAIL="investor@stokiffy.local"
# Bcrypt hash of master passphrase (generate via: node -e 'console.log(require("bcryptjs").hashSync("mypassphrase", 10))')
ADMIN_PASSWORD_HASH="$2a$10$YourBcryptPasswordHashHere"

# Personal Dev Auth Fallback
# When true, bypasses login and injects the default owner session for local testing.
# In production on Vercel, set to false.
ALLOW_PERSONAL_DEV_AUTH="true"
PERSONAL_MODE="true"

# Logging Level ('debug' | 'info' | 'warn' | 'error')
LOG_LEVEL="info"

# Background Worker Settings
WORKER_CONCURRENCY=5
WORKER_POLL_INTERVAL_SECONDS=2
WORKER_DRAIN_TIMEOUT_MS=10000

# Shared File Storage Directories (Optional explicit paths; defaults to storage/jobs and storage/staged)
# JOBS_DIR=./storage/jobs
# STAGING_DIR=./storage/staged
